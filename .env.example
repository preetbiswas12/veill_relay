# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-random-256-bit-secret
CORS_ORIGIN=http://localhost:5173

# SQLite database path (relative to project root)
DB_PATH=./veill.db

# LiveKit (WebRTC calls via DGX + Cloudflare Tunnel)
LIVEKIT_URL=wss://preetllm.qzz.io
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-random-livekit-secret

# Firebase Admin SDK (optional — leave empty to disable FCM push)
# Paste the entire JSON content of your serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# Media storage
MEDIA_DIR=./media
MEDIA_MAX_AGE_MS=86400000
