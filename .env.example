# Server
PORT=3000
JWT_SECRET=change-me-to-a-random-secret
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://localhost:5432/veill

# LiveKit (WebRTC calls via DGX + Cloudflare Tunnel)
LIVEKIT_URL=wss://preetllm.qzz.io
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Firebase Admin SDK (optional — leave empty to disable FCM push)
# Paste the entire JSON content of your serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# Chunk relay
CHUNK_TEMP_DIR=/tmp/veill-chunks
CHUNK_MAX_AGE_MS=86400000
